@baseUrl = http://127.0.0.1:8765

### Select Foundry for captions (204; 409 if the saved Foundry connection has not passed the Speech test)
PUT {{baseUrl}}/api/settings/ai/speech/source
X-VideoCreator: 1
Content-Type: application/json

{"use_foundry":true}

### Select the separate Speech settings without deleting either connection
PUT {{baseUrl}}/api/settings/ai/speech/source
X-VideoCreator: 1
Content-Type: application/json

{"use_foundry":false}
