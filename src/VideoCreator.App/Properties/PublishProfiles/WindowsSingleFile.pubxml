<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Physical paths are required by FFmpeg, ONNX and the static file provider. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- The app uses UseStaticFiles, not MapStaticAssets; publish these as ordinary bundled content. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="build" />
    <Content Update="wwwroot\**\*;appsettings.json" ExcludeFromSingleFile="false" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="..\..\presets\*.json" Link="presets\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ffmpeg\bin\ffmpeg.exe;..\..\tools\ffmpeg\bin\ffprobe.exe"
             Link="tools\ffmpeg\bin\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ffmpeg\LICENSE.txt"
             Link="tools\ffmpeg\LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\fonts\*.ttf;..\..\tools\fonts\*.otf;..\..\tools\fonts\*.txt"
             Link="tools\fonts\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\models\*.onnx;..\..\tools\models\*-LICENSE.txt"
             Link="tools\models\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.txt"
             Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeSingleFileDirectML" BeforeTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_DirectMLArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</_DirectMLArchitecture>
      <_DirectMLArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</_DirectMLArchitecture>
    </PropertyGroup>
    <Error Condition="'$(_DirectMLArchitecture)' == ''" Text="WindowsSingleFile requires win-arm64 or win-x64." />
    <ItemGroup>
      <!-- DirectML is a build-only transitive NuGet asset, not a RID-native publish asset. -->
      <ResolvedFileToPublish Include="$(PkgMicrosoft_AI_DirectML)\bin\$(_DirectMLArchitecture)-win\DirectML.dll"
                             RelativePath="DirectML.dll" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(PkgMicrosoft_AI_DirectML)\LICENSE.txt"
                             RelativePath="licenses\DirectML-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(PkgMicrosoft_AI_DirectML)\ThirdPartyNotices.txt"
                             RelativePath="licenses\DirectML-ThirdPartyNotices.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveSingleFilePublishSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
