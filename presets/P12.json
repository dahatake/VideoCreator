{
  "id": "P12",
  "version": "1.0.0",
  "name": "ショート動画（縦 9:16）",
  "genre": "全ジャンル（Shorts / TikTok / Reels）",
  "available": true,
  "short": true,
  "target": {
    "duration_sec": [
      15,
      60
    ],
    "aspect": "9:16"
  },
  "hook": {
    "prefer": [
      "strong_claim",
      "surprise",
      "question",
      "laughter"
    ],
    "max_sec": 2.0
  },
  "cut": {
    "snap_to": [
      "sentence_end",
      "shot_boundary"
    ],
    "min_shot_sec": 1.0,
    "target_asl_sec": [
      1.5,
      3.0
    ],
    "remove_silence_over_sec": 0.5,
    "punch_in_scale": 1.15,
    "cold_open": "teaser"
  },
  "telop": {
    "types": [
      "caption",
      "emphasis",
      "headline"
    ],
    "caption": {
      "max_lines": 1,
      "margin_v": 620,
      "margin_r": 160,
      "font_px": 78,
      "max_cps": 6,
      "max_chars_per_line": 14
    }
  },
  "audio": {
    "sfx": "light",
    "bgm_duck_db": -15,
    "loudnorm": {
      "tp": -1.5,
      "i": -14
    },
    "bgm": "none"
  },
  "loop": {
    "required": false,
    "enabled": true
  },
  "card": {
    "opening": "最も強い一言・驚き・問いを冒頭2秒に（オープニング動画は入れない）",
    "tempo": "無音を詰めたジャンプカット＋パンチイン、15〜60秒",
    "telop": "全文字幕・強調・見出し（スマホの操作ボタンを避ける）",
    "sound": "原音を -14 LUFS に整え、終わりを冒頭につなげる"
  },
  "examples": [
    {
      "title": "YouTube ヘルプ: 3 分間の YouTube ショートについて",
      "url": "https://support.google.com/youtube/answer/15424877"
    }
  ],
  "selection_rules": "スマホで縦に見るショート動画として、元動画を見ていない人にも単体で意味が通る15〜60秒を選ぶ。冒頭2秒に結果・驚き・強い主張・問いがあり、最後にオチ（ペイオフ）があること。説明の前置き・挨拶・自己紹介から始めない。",
  "planner": "speech",
  "reframe": "auto"
}
