{
  "id": "P5",
  "version": "1.0.1",
  "name": "ビート同期モンタージュ",
  "genre": "趣味/Vlog",
  "available": true,
  "target": {
    "duration_sec": [
      15,
      60
    ],
    "aspect": "9:16"
  },
  "hook": {
    "prefer": [
      "result"
    ],
    "max_sec": 1.5
  },
  "cut": {
    "snap_to": [
      "shot_boundary"
    ],
    "min_shot_sec": 0.5,
    "target_asl_sec": [
      0.5,
      1.5
    ],
    "remove_silence_over_sec": null,
    "punch_in_scale": 1.1,
    "cold_open": "none"
  },
  "telop": {
    "types": [
      "headline"
    ],
    "caption": {
      "max_lines": 1,
      "margin_v": 620,
      "margin_r": 160,
      "font_px": 78,
      "max_cps": 6,
      "max_chars_per_line": 14
    }
  },
  "audio": {
    "sfx": "none",
    "bgm_duck_db": -15,
    "loudnorm": {
      "tp": -1.5,
      "i": -14
    },
    "bgm": "auto",
    "duck": false,
    "dialogue_gain_db": -12,
    "bgm_db": -8,
    "bgm_gap_lu": 0,
    "bgm_speech_ld": 10
  },
  "loop": {
    "required": false,
    "enabled": false
  },
  "card": {
    "opening": "完成品・絶景から",
    "tempo": "音楽のビートに合わせてカット",
    "telop": "見出しのみ",
    "sound": "BGM主導"
  },
  "examples": [
    {
      "title": "Casey Neistat: DO WHAT YOU CAN'T",
      "url": "https://www.youtube.com/watch?v=jG7dSXcfVqE"
    }
  ],
  "planner": "beat",
  "reframe": "auto",
  "selection_rules": "BGM のビートに合わせて、映像の見どころを拍の長さでつなぐ。"
}
